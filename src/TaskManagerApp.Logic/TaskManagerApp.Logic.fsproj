<Project Sdk="Microsoft.NET.Sdk">

  <!-- Domain, MVU state and authentication: plain .NET with no MAUI or Fabulous dependency, so it is
       unit-tested on any machine and referenced by the fsdocs scripts in docs/ -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Domain.fs" />
    <Compile Include="MockData.fs" />
    <Compile Include="Auth\Types.fs" />
    <Compile Include="Auth\Pkce.fs" />
    <Compile Include="Auth\Jwt.fs" />
    <Compile Include="Auth\Oidc.fs" />
    <Compile Include="Auth\Providers.fs" />
    <Compile Include="Auth\Loopback.fs" />
    <Compile Include="Auth\SessionJson.fs" />
    <Compile Include="Auth\SessionManager.fs" />
    <Compile Include="Http.fs" />
    <Compile Include="Features\TaskList\Types.fs" />
    <Compile Include="Features\TaskList\State.fs" />
    <Compile Include="Features\TaskDetail\Types.fs" />
    <Compile Include="Features\TaskDetail\State.fs" />
    <Compile Include="Root\Types.fs" />
    <Compile Include="Root\State.fs" />
  </ItemGroup>

</Project>
